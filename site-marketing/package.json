{
  "name": "site-marketing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "docs:openapi": "node --experimental-strip-types scripts/generate-openapi-docs.mts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-openapi": "11.0.5",
    "fumadocs-ui": "16.10.5",
    "lucide-react": "0.545.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260626-071224-83acc441",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/intent": "0.5.5",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vite": "8.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core",
      "@tanstack/router-plugin"
    ],
    "exclude": [
      "@tanstack/react-start#lifecycle/migrate-from-nextjs",
      "@tanstack/react-start#react-start/server-components"
    ]
  }
}
