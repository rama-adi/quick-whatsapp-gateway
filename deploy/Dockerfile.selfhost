# syntax=docker/dockerfile:1
# SELF-HOST app image: API + gateway + frontend in one container.
#
# This is for simple single-box installs. MySQL, Redis, and the WhatsApp
# keystore remain outside the image on Compose services/volumes.

# --- Stage 1: build Go binaries ---
FROM golang:1.26-alpine AS go-build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api
RUN CGO_ENABLED=0 go build -o /out/gateway ./cmd/gateway

# --- Stage 2: build frontend ---
FROM node:22-alpine AS web-build
WORKDIR /web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
ARG VITE_GATEWAY_URL=""
ENV VITE_GATEWAY_URL=${VITE_GATEWAY_URL}
ENV NITRO_PRESET=node-server SERVER_PRESET=node-server
RUN pnpm build

# --- Stage 2b: public edge proxy ---
FROM caddy:2-alpine AS caddy

# --- Stage 3: runtime ---
FROM node:22-alpine
LABEL language="nodejs"
RUN apk add --no-cache ca-certificates tzdata
ENV NODE_ENV=production
WORKDIR /app

COPY --from=go-build /out/api /usr/local/bin/api
COPY --from=go-build /out/gateway /usr/local/bin/gateway
COPY --from=caddy /usr/bin/caddy /usr/local/bin/caddy
COPY --from=web-build /web/.output /web/.output
COPY docs/openapi.yaml /app/docs/openapi.yaml
COPY docs/openapi.yaml /docs/openapi.yaml
COPY deploy/Caddyfile.selfhost /etc/caddy/Caddyfile
COPY deploy/selfhost-entrypoint.sh /usr/local/bin/selfhost-entrypoint
RUN chmod +x /usr/local/bin/selfhost-entrypoint

VOLUME ["/data/keystore"]
EXPOSE 8080
ENTRYPOINT ["selfhost-entrypoint"]
