# API + GATEWAY (Go / whatsmeow) configuration — masterplan §14.
# Copy to deploy/.env and fill in. This one file is the env for BOTH the host
# (`make dev` loads deploy/.env) and the Docker dev profiles (`--profile
# api|gateway[-dev]` read it via env_file). In prod the values are real
# env vars injected by your platform. `deploy/docker-compose.selfhost.yml` also
# reads the frontend essentials from this file for a single-box install. Full
# frontend vars live separately in web/.env.example.
#
# Topology: the API is the single public front door + trust boundary and the
# owner of all MySQL/Redis state. The GATEWAY is a private WhatsApp engine:
# it holds only its SQLite whatsmeow keystore + event journal, talks to the
# API over the mandatory mTLS control plane, and serves no public API.

# --- API control plane ---
# Public HTTP and gRPC listen addresses. They must differ.
API_HTTP_ADDR=:8090
API_PUBLIC_GRPC_ADDR=:8081
# Private gateway control-plane listener (mTLS). Enable with
# deploy/docker-compose.grpc-control-plane.yml; never publish this port to the host.
# API_GATEWAY_GRPC_ADDR=:8443
# API_GATEWAY_TLS_IDENTITY_DIR=/data/api-tls
# API_GATEWAY_TLS_RENEW_BEFORE=6h
# API_GATEWAY_ENGINE_UNARY_DEADLINE=2s
# API_GATEWAY_ENGINE_SEND_DEADLINE=4m
# PKI_ENCRYPTION_KEY=<canonical-base64-32-byte-key>
# PKI_ENCRYPTION_KEY_ID=local-v1
# External HTTP base URL browsers and clients use.
API_PUBLIC_URL=http://localhost:8090
# External-compose host mappings; container listeners stay fixed at 8090/8081.
API_HTTP_PORT=8090
API_PUBLIC_GRPC_PORT=8081

# --- Gateway: control plane (REQUIRED — the gateway cannot run without it) ---
GATEWAY_CONTROL_PLANE_ADDR=api:8443
GATEWAY_CREDENTIAL_DIR=/data/gateway-credentials
GATEWAY_BOOTSTRAP_CA_FILE=/absolute/host/path/to/operator-root.pem
# One-time enrollment token; omit after successful enrollment.
GATEWAY_ENROLLMENT_TOKEN=
GATEWAY_CERTIFICATE_RENEW_BEFORE=6h
# Private mTLS engine listener + the address the API dials back on.
GATEWAY_ENGINE_GRPC_ADDR=:9443
GATEWAY_ENGINE_GRPC_ADVERTISE_ADDR=gateway:9443
# Persistent gateway event journal (absolute path).
GATEWAY_JOURNAL_PATH=/data/keystore/journal.db

# --- Sign in with WhatsApp (OIDC provider) ---
# Public issuer for OIDC discovery and JWT iss. Defaults to API_PUBLIC_URL.
# OIDC_ISSUER=http://localhost:8090
# AES-GCM key for oauth_signing_keys.private_enc. REQUIRED for API OIDC.
# Generate with: openssl rand -base64 32
OIDC_KEY_ENC_KEY=
# Client secret pepper and protocol TTL defaults used by later OAuth milestones.
OAUTH_CLIENT_SECRET_PEPPER=
# AES-GCM key protecting webhook HMAC secrets; required by the API (Increment 7).
APP_ENCRYPTION_KEY=
WEB_LOGIN_URL=http://localhost:3000/login/whatsapp
OIDC_REQUEST_TTL_SECONDS=600
OIDC_AUTHCODE_TTL_SECONDS=60

# --- HTTP / server ---
# Gateway probes only (healthz/readyz/metrics); there is no public gateway API.
GATEWAY_HTTP_ADDR=:8080
# This gateway's id (canonical PKI identity name, rows in `gateways`).
GATEWAY_ID=gw-1

# --- Trust seam (better-auth) — the API's authn inputs ---
# The frontend's base URL = the JWT iss/aud the API enforces. No trailing slash.
BETTER_AUTH_URL=http://localhost:3000
# JWKS endpoint to fetch/cache. Defaults to ${BETTER_AUTH_URL}/api/auth/jwks if unset.
# BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Comma-list of browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000

# --- Secrets ---
APP_ENCRYPTION_KEY=        # base64 32-byte AES-GCM key: openssl rand -base64 32
# Required by the frontend in the self-host compose file: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- App data store (shared MySQL) — API-only ---
MYSQL_DSN=gw:gwpass@tcp(127.0.0.1:3306)/gateway?parseTime=true&charset=utf8mb4&clientFoundRows=true

# --- whatsmeow keystore (pure-Go SQLite, gateway-local) ---
# Must be an explicit absolute file: path on the persistent keystore volume.
WHATSMEOW_STORE_DSN=file:/data/keystore/store.db?_pragma=foreign_keys(on)&_pragma=journal_mode(WAL)

# --- Redis — API-only (queue, realtime fan-out, cache, control bus) ---
REDIS_URL=redis://127.0.0.1:6379
# Control bus for cross-service ctrl:* pub/sub (key/user revocation). The API
# subscribes to it (evicting its api-key cache); the frontend publishes to it.
# Defaults to REDIS_URL in single-instance deployments.
# PUBSUB_REDIS_URL=redis://127.0.0.1:6379
# Key/channel namespace so multiple stacks can share one Redis.
REDIS_PREFIX=gw

# --- Per-session defaults (seeds assignments) ---
DEFAULT_RATE_PER_MIN=20
DEFAULT_RATE_PER_HOUR=200
DEFAULT_AUTO_READ=true

# --- Source-level ignore rules ---
IGNORE_STATUS=false
IGNORE_GROUPS=false
IGNORE_CHANNELS=false
IGNORE_BROADCAST=false

# --- Data retention ---
# 0 keeps messages, realtime replay history, and terminal webhook-delivery rows
# forever. A positive value retains at least that many full UTC days; the API
# schedules retention prunes over its shared work Redis database and REDIS_PREFIX.
RETENTION_DAYS=0

# --- Observability ---
LOG_LEVEL=info

# --- Frontend note (web/.env.example) ---
# The browser-facing API base URL (VITE_GATEWAY_URL in web/.env.example) must
# point at the API (port 8090 / API_PUBLIC_URL), NOT the gateway (8080).
# The API is the single public front door.
# Self-host default is locked down: USER_REGISTRATION_ENABLED=false unless you
# explicitly set it true in deploy/.env.
USER_REGISTRATION_ENABLED=false
# Optional: comma-separated better-auth user ids granted platform super-admin.
ADMIN_USER_IDS=
