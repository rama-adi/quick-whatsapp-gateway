# syntax=docker/dockerfile:1
# API image (Go / control plane). Build context is the repo root:
#   docker build -t whatsmeow-api -f deploy/Dockerfile.api .
#
# The API is the single public front door / trust boundary in front of the
# gateways: it authenticates end-user callers (better-auth JWT or api-key),
# resolves session->owning gateway, and reverse-proxies with a request-bound
# Ed25519 internal assertion. It is STATELESS — no keystore volume.

# --- Stage 1: build the Go binary (pure-Go, no CGO) ---
# Pinned to golang:1.26-alpine to match go.mod. CGO_ENABLED=0 yields a fully
# static binary with no gcc/musl-dev needed.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api

# --- Stage 2: minimal runtime ---
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/api /usr/local/bin/api
# Ship the generated API contract so the API can serve it at
# /api/v1/openapi.yaml (OpenAPIPath defaults to the relative "docs/openapi.yaml",
# resolved from the working directory).
WORKDIR /app
COPY --from=build /src/docs/openapi.yaml ./docs/openapi.yaml
EXPOSE 8090 8081 8443
ENTRYPOINT ["api"]
